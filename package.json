{
  "name": "codeatlas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "node -e \"const fs=require('fs');['.next','.next-dev'].forEach((d)=>fs.rmSync(d,{recursive:true,force:true}));\"",
    "clean:dev": "node -e \"require('fs').rmSync('.next-dev',{recursive:true,force:true})\"",
    "dev:clean": "npm run clean:dev && next dev -H 127.0.0.1",
    "dev": "next dev -H 127.0.0.1",
    "fill:tools": "node scripts/fill-tools.mjs",
    "fill:buy": "node scripts/seed-buy-content.mjs --write",
    "compute:popularity": "node scripts/compute-tool-github-appearance.mjs",
    "compute:wechat-heat": "node scripts/compute-tool-wechat-heat.mjs",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "lint": "next lint",
    "healthcheck:post-deploy": "node scripts/post-deploy-healthcheck.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "next": "^14.2.35",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.23",
    "eslint": "^8",
    "eslint-config-next": "^14",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.9.3"
  }
}
